    {
      "id": "BKJssLWfXpHuX0zf9XL_e",
      "type": "text",
      "x": 924.9929802894565,
      "y": 3073.4115633722995,
      "width": 2456.494873046875,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 99050160,
      "version": 1029,
      "versionNonce": 1801857712,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792643562479,
      "created": 1792642963886,
      "link": null,
      "locked": false,
      "text": "- For the local development in insurance service, agent need to set up healthcare service \n- we dont know what dependencies healthcare service has in order to set it working on my local\n- we will call context graph to know the dependencies\n- we will realise that for insurance claim data, you need some information that is not available in\nhealthcare.dev\n- through context graph api, we will know which project needs to supply that data.\n- which in our case is going to be patient service\n- We will create simulation of healthcare.dev and billing service - which needs us to run healthcare.dev and billing service in my local computer\n- we will create api to show claim - insurance id, name, amount",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- For the local development in insurance service, agent need to set up healthcare service \n- we dont know what dependencies healthcare service has in order to set it working on my local\n- we will call context graph to know the dependencies\n- we will realise that for insurance claim data, you need some information that is not available in\nhealthcare.dev\n- through context graph api, we will know which project needs to supply that data.\n- which in our case is going to be patient service\n- We will create simulation of healthcare.dev and billing service - which needs us to run healthcare.dev and billing service in my local computer\n- we will create api to show claim - insurance id, name, amount",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
