{
  "info": {
    "name": "PayPal invoicing perf",
    "description": "Load/functional workflow for PayPal invoicing, built from the Postman Context Graph (asks 01a136b8-4882-799c-9b2e-bb077fd87da9 and 01a136c9-eabd-7007-a8f6-d0e64ac9349d). Graph-resolved call order, one iteration per virtual user: GET patient → POST invoicing (calls GET patient) → POST invoicing/:id/send (PayPal, healthcare-infra) → GET invoicing/:id (status check) → POST payments (calls GET invoicing) → GET payments/:id → POST statements (calls GET invoicing) → GET invoicing and GET payments lists (the other graph status-check endpoints) → delete statement, payment, invoicing row. Each VU owns and deletes its own rows. Against the live gateway every iteration creates a real PayPal invoice and emails the patient on file — run `postman performance run` against a mock (supply `perf_target=mock` through --data-file) or at very low VU counts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get patient",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"patient exists\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});",
              "pm.test(\"patient has an email on file (required by /send)\", function () {",
              "  const email = String(pm.response.json().email || \"\").trim();",
              "  pm.expect(email, \"patient.email\").to.not.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/patients/{{patient_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "patients",
            "{{patient_id}}"
          ]
        },
        "description": "Graph edge: POST /api/invoicing → GET /api/patients/:patient_id. The patient must exist and carry an email, or /send later 422s `no_email`."
      },
      "response": []
    },
    {
      "name": "2. Create invoicing",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"perf_amount\", String(10 + Math.floor(Math.random() * 500)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invoicing row created (201)\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"row has an id\", function () {",
              "  const id = pm.response.json().id;",
              "  pm.expect(id).to.exist;",
              "  pm.collectionVariables.set(\"perf_invoice_id\", String(id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoicing",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoicing"
          ]
        },
        "description": "Graph: POST /api/invoicing (CALLS GET /api/patients/:patient_id). Creates the row this iteration bills. `status` is \"pending\" because /send refuses paid, void, cancelled and written-off rows. The amount is randomised per iteration (10–509) so concurrent VUs produce distinct PayPal invoices.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"pending\",\n  \"patient_id\": \"{{patient_id}}\",\n  \"encounter_id\": \"{{encounter_id}}\",\n  \"claim_id\": \"{{claim_id}}\",\n  \"amount\": {{perf_amount}},\n  \"description\": \"perf-test invoice\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3. Send invoice via PayPal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invoice sent (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"send returns a PayPal invoice with a payer-view link\", function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.paypal_invoice).to.have.property(\"id\");",
              "  pm.expect(body.paypal_invoice.id).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(body.paypal_invoice.payer_view_url).to.be.a(\"string\").and.not.empty;",
              "  pm.collectionVariables.set(\"perf_paypal_invoice_id\", body.paypal_invoice.id);",
              "});",
              "pm.test(\"first send reports invoice_sent=true and status sent\", function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.invoice_sent).to.eql(true);",
              "  pm.expect(body.status).to.eql(\"sent\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoicing/{{perf_invoice_id}}/send",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoicing",
            "{{perf_invoice_id}}",
            "send"
          ]
        },
        "description": "Graph: POST /api/invoicing/:id/send, \"Create and send an invoice via PayPal\" (healthcare-infra; the PayPal ExternalService is attached to this API; Supabase is its database). The graph records no endpoint-level edges for it, so this step is the PayPal hop in the chain. `include_description` stays false so the clinical description never leaves the BAA boundary.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item_name\": \"Medical services\",\n  \"include_description\": false,\n  \"due_days\": 30,\n  \"subject\": \"Invoice from your care team\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "4. Get invoicing by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invoicing row readable (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});",
              "if (pm.variables.get(\"perf_target\") !== \"mock\") {",
              "  pm.test(\"row is sent and linked to the PayPal invoice\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(\"sent\");",
              "    pm.expect(body.paypal_invoice_id).to.eql(pm.collectionVariables.get(\"perf_paypal_invoice_id\"));",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoicing/{{perf_invoice_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoicing",
            "{{perf_invoice_id}}"
          ]
        },
        "description": "Graph: GET /api/invoicing/:id is the status-check endpoint for an invoice, and the call POST /api/payments depends on. After /send the row must read back as sent with the PayPal invoice pointer persisted."
      },
      "response": []
    },
    {
      "name": "5. Record payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"payment created (201)\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"payment has an id\", function () {",
              "  const id = pm.response.json().id;",
              "  pm.expect(id).to.exist;",
              "  pm.collectionVariables.set(\"perf_payment_id\", String(id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ]
        },
        "description": "Graph: POST /api/payments (CALLS GET /api/invoicing/:record_id) is how a payment is written after an invoice is sent. Method \"paypal\" matches the gateway's payment-method options. (The graph's POST /api/payments/pay, \"Record a payment and publish invoice.paid\", is exposed by payments-service but not by healthcare-infra, so it is not part of this flow.)",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"active\",\n  \"patient_id\": \"{{patient_id}}\",\n  \"invoice_id\": \"{{perf_invoice_id}}\",\n  \"amount\": {{perf_amount}},\n  \"method\": \"paypal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "6. Get payment by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"payment readable (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});",
              "if (pm.variables.get(\"perf_target\") !== \"mock\") {",
              "  pm.test(\"payment is linked to this invoice and amount\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(String(body.invoice_id)).to.eql(pm.collectionVariables.get(\"perf_invoice_id\"));",
              "    pm.expect(Number(body.amount)).to.eql(Number(pm.collectionVariables.get(\"perf_amount\")));",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{perf_payment_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "{{perf_payment_id}}"
          ]
        },
        "description": "Graph: GET /api/payments/:id is the status-check endpoint for a payment. The payment must read back linked to this iteration's invoice and amount."
      },
      "response": []
    },
    {
      "name": "7. Create statement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"statement created (201)\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"statement has an id\", function () {",
              "  const id = pm.response.json().id;",
              "  pm.expect(id).to.exist;",
              "  pm.collectionVariables.set(\"perf_statement_id\", String(id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/statements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "statements"
          ]
        },
        "description": "Graph: POST /api/statements (statements-service CALLS GET /api/invoicing/:record_id, and per the graph also GET patients) — the other downstream consumer of an invoice.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"active\",\n  \"patient_id\": \"{{patient_id}}\",\n  \"invoice_id\": \"{{perf_invoice_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "8. List invoicing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invoicing list ok (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().items).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoicing?limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoicing"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Graph: GET /api/invoicing is one of the four endpoints a client uses to check invoice state. Limited to 5 rows so list cost stays flat as load runs add and remove rows."
      },
      "response": []
    },
    {
      "name": "9. List payments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"payments list ok (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().items).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments?limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Graph: GET /api/payments is the fourth invoice/payment status-check endpoint on healthcare-infra. Limited to 5 rows."
      },
      "response": []
    },
    {
      "name": "10. Delete statement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"statement deleted (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().deleted).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/statements/{{perf_statement_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "statements",
            "{{perf_statement_id}}"
          ]
        },
        "description": "Cleanup, children first: statements and payments reference the invoice, so they go before the invoicing row."
      },
      "response": []
    },
    {
      "name": "11. Delete payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"payment deleted (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().deleted).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{perf_payment_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "{{perf_payment_id}}"
          ]
        },
        "description": "Cleanup, removes this iteration's payment row."
      },
      "response": []
    },
    {
      "name": "12. Delete invoicing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invoicing row deleted (200)\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().deleted).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoicing/{{perf_invoice_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoicing",
            "{{perf_invoice_id}}"
          ]
        },
        "description": "Cleanup: removes this iteration's invoicing row. Only the local row goes: the gateway has no PayPal cancel endpoint, so the PayPal invoice remains in the sandbox dashboard."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://myhealthcare.dev",
      "description": "Gateway base URL. Redirected to a mock with --use-mock."
    },
    {
      "key": "apiKey",
      "value": "",
      "description": "Gateway bearer token. Supply it from the environment (-e); never commit it. Any value works against a mock."
    },
    {
      "key": "patient_id",
      "value": "1",
      "description": "Patient to bill. Must have an email on file."
    },
    {
      "key": "encounter_id",
      "value": "1"
    },
    {
      "key": "claim_id",
      "value": "1"
    },
    {
      "key": "perf_target",
      "value": "live",
      "description": "\"live\" asserts real semantics; \"mock\" checks contract shape only, since a canned mock cannot satisfy them."
    },
    {
      "key": "perf_amount",
      "value": "25",
      "description": "Set per iteration by step 2's pre-request script."
    },
    {
      "key": "perf_invoice_id",
      "value": "",
      "description": "Set by step 2; the invoicing row this iteration owns."
    },
    {
      "key": "perf_paypal_invoice_id",
      "value": "",
      "description": "Set by step 3; the PayPal invoice the row points at."
    },
    {
      "key": "perf_payment_id",
      "value": "",
      "description": "Set by step 5; the payment row this iteration owns."
    },
    {
      "key": "perf_statement_id",
      "value": "",
      "description": "Set by step 7; the statement row this iteration owns."
    }
  ]
}
