# External / sibling projects that live in their own git repos
services/
libs/
orbit-mcp/
tools/

# Node / TypeScript build artifacts
node_modules/
dist/
*.tsbuildinfo

# `tsc -b` emits .js next to .ts in place (no outDir configured for
# frontend/api) — Vercel's build fails outright if both land in git, since
# it can't disambiguate api/foo.js from api/foo.ts as the same route.
frontend/api/**/*.js

# Vercel workspace state (project link is created via `vercel link`)
.vercel/

# Secrets — never commit
.env
.env.local
.env.*.local

# Docker orchestrator scratch file (regenerated by run.sh)
.run-orchestrator.compose.yml

# Editor / OS noise
.DS_Store
.mcp.json
